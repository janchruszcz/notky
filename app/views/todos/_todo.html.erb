<div
  id="<%= dom_id todo %>"
  class="
    group/todo
    flex items-start gap-3
    p-2.5 rounded-lg
    bg-white/40 hover:bg-white/60
    border border-transparent hover:border-yellow-300
    transition-all duration-150
    <%= 'opacity-60' if todo.completed? %>
  "
  data-controller="todos"
  data-completed="<%= todo.completed? %>"
>
  <%# Checkbox %>
  <div class="flex-shrink-0 pt-0.5">
    <%= form_with model: todo, class: "contents", data: { controller: "auto-submit" }, local: false do |form| %>
      <%= turbo_frame_tag dom_id(todo, "completed") do %>
        <%= form.check_box :completed,
            id: dom_id(todo, "completed"),
            class: "h-5 w-5 rounded-full border-2 border-slate-300 text-green-600 focus:ring-green-500 focus:ring-offset-0 cursor-pointer transition-colors",
            data: { action: "auto-submit#submit click->todos#toggleCrossOut", "todos-target": "checkbox" }
        %>
      <% end %>
    <% end %>
  </div>

  <%# Content %>
  <div class="flex-1 min-w-0">
    <%= form_with model: todo, class: "contents", data: { turbo_frame: dom_id(todo, "title") } do %>
      <%= turbo_frame_tag dom_id(todo, "title"), data: { controller: "inline-edit" } do %>
        <p
          data-todos-target="paragraph"
          class="text-sm font-medium text-slate-700 <%= 'line-through text-slate-400' if todo.completed? %>"
        >
          <%= link_to todo.title, edit_todo_path(todo), data: { turbo_frame: 'modal' }, class: "hover:text-slate-900 transition-colors" %>
        </p>
      <% end %>
    <% end %>

    <%# Due date badge %>
    <% if todo.due_date.present? %>
      <div class="mt-1.5 flex items-center gap-1">
        <% if todo.overdue? %>
          <span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-red-100 text-red-700">
            <%= heroicon('exclamation-circle', variant: :mini, options: { class: 'h-3 w-3' }) %>
            <span>Overdue</span>
          </span>
        <% elsif todo.due_soon? %>
          <span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-orange-100 text-orange-700">
            <%= heroicon('clock', variant: :mini, options: { class: 'h-3 w-3' }) %>
            <span><%= todo.due_date.strftime('%b %d') %></span>
          </span>
        <% else %>
          <span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full bg-slate-100 text-slate-600">
            <%= heroicon('calendar', variant: :mini, options: { class: 'h-3 w-3' }) %>
            <span><%= todo.due_date.strftime('%b %d') %></span>
          </span>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Actions %>
  <div class="flex-shrink-0 flex items-center gap-1 opacity-0 group-hover/todo:opacity-100 transition-opacity">
    <%= form_with model: todo, class: "contents" do |form| %>
      <%= form.date_field :due_date,
          class: "w-8 h-8 p-1.5 rounded-full text-slate-400 hover:text-slate-600 hover:bg-yellow-200/50 cursor-pointer border-none bg-transparent",
          data: { controller: "flatpickr", action: "change->auto-submit#submit" },
          title: "Set due date"
      %>
    <% end %>

    <%= button_to todo_path(todo), method: :delete, data: { turbo_confirm: 'Delete this task?' }, class: "p-1.5 rounded-full text-slate-400 hover:text-red-600 hover:bg-yellow-200/50 transition-colors" do %>
      <%= heroicon('trash', variant: :mini, options: { class: 'h-4 w-4' }) %>
    <% end %>
  </div>
</div>
