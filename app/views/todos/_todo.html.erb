<div
  id="<%= dom_id todo %>"
  class="todo-item group/todo <%= 'completed' if todo.completed? %>"
  data-controller="todo-item"
  data-todo-item-completed-value="<%= todo.completed? %>"
>
  <%# Checkbox %>
  <div class="flex-shrink-0 pt-0.5">
    <%= form_with model: todo, class: "contents", data: { controller: "auto-submit" } do |form| %>
      <%= form.check_box :completed,
          class: "h-5 w-5 rounded-full border-2 border-cork-400 text-green-600 focus:ring-green-500 focus:ring-offset-0 cursor-pointer transition-all duration-200",
          data: { action: "auto-submit#submit todo-item#toggle", "todo-item-target": "checkbox" }
      %>
    <% end %>
  </div>

  <%# Content with inline editing %>
  <div class="flex-1 min-w-0">
    <div
      data-controller="inline-edit"
      data-inline-edit-url-value="<%= todo_path(todo) %>"
      class="relative"
    >
      <%# Display mode %>
      <p
        class="todo-text cursor-text hover:bg-white/40 px-1 py-0.5 -mx-1 rounded transition-colors"
        data-inline-edit-target="display"
        data-todo-item-target="text"
        data-action="click->inline-edit#edit"
        title="Click to edit"
      >
        <%= todo.title %>
      </p>

      <%# Edit mode (hidden by default) %>
      <%= form_with model: todo, class: "hidden", data: { "inline-edit-target": "form" } do |form| %>
        <%= form.text_field :title,
            class: "w-full bg-white/80 border-0 border-b-2 border-cork-400 focus:border-cork-600 focus:ring-0 font-handwriting text-lg text-cork-700 px-1 py-0.5 -mx-1 rounded-t",
            data: {
              "inline-edit-target": "input",
              action: "blur->inline-edit#save keydown.enter->inline-edit#save keydown.escape->inline-edit#cancel"
            }
        %>
      <% end %>
    </div>

    <%# Due date badge %>
    <% if todo.due_date.present? %>
      <div class="mt-1 flex items-center gap-1">
        <% if todo.overdue? %>
          <span class="badge-overdue">
            <%= heroicon('exclamation-circle', variant: :mini, options: { class: 'h-3 w-3' }) %>
            <span>Overdue</span>
          </span>
        <% elsif todo.due_soon? %>
          <span class="badge-soon">
            <%= heroicon('clock', variant: :mini, options: { class: 'h-3 w-3' }) %>
            <span><%= todo.due_date.strftime('%b %d') %></span>
          </span>
        <% else %>
          <span class="badge-normal">
            <%= heroicon('calendar', variant: :mini, options: { class: 'h-3 w-3' }) %>
            <span><%= todo.due_date.strftime('%b %d') %></span>
          </span>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Actions - visible on hover %>
  <div class="flex-shrink-0 flex items-center gap-0.5 opacity-0 group-hover/todo:opacity-100 transition-opacity duration-150">
    <%# Date picker %>
    <%= form_with model: todo, class: "contents", data: { controller: "auto-submit" } do |form| %>
      <%= form.date_field :due_date,
          class: "w-7 h-7 p-1 rounded-full text-cork-400 hover:text-cork-600 hover:bg-white/50 cursor-pointer border-none bg-transparent text-xs",
          data: { controller: "flatpickr", action: "change->auto-submit#submit" },
          title: "Set due date"
      %>
    <% end %>

    <%# Delete button %>
    <%= button_to todo_path(todo), method: :delete, data: { turbo_confirm: 'Delete this task?' }, class: "p-1 rounded-full text-cork-400 hover:text-red-600 hover:bg-white/50 transition-colors" do %>
      <%= heroicon('trash', variant: :mini, options: { class: 'h-4 w-4' }) %>
    <% end %>
  </div>
</div>
