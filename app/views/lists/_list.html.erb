<%# Assign random rotation for natural look %>
<% rotations = ['rotate-note-1', 'rotate-note-2', 'rotate-note-3', 'rotate-note-4', 'rotate-note-5'] %>
<% colors = ['note-yellow', 'note-pink', 'note-blue', 'note-green', 'note-purple', 'note-orange'] %>
<% note_color = colors[list.id % colors.length] %>
<% note_rotation = rotations[list.id % rotations.length] %>

<div
  id="<%= dom_id list %>"
  class="group sticky-note <%= note_color %> <%= note_rotation %> flex flex-col"
  data-controller="list"
  data-list-id="<%= list.id %>"
>
  <%# Push pin %>
  <div class="push-pin" aria-hidden="true"></div>

  <%# Header with inline editable title %>
  <header class="pt-4 mb-3">
    <%= turbo_frame_tag dom_id(list, "title") do %>
      <div
        class="group/title flex items-center justify-center gap-2"
        data-controller="inline-edit"
        data-inline-edit-url-value="<%= list_path(list) %>"
      >
        <h3
          class="note-title text-center cursor-text hover:bg-white/30 px-2 py-1 rounded transition-colors"
          data-inline-edit-target="display"
          data-action="click->inline-edit#edit"
          title="Click to edit"
        >
          <%= list.title %>
        </h3>

        <%# Edit form (hidden by default) %>
        <%= form_with model: list, class: "hidden w-full", data: { "inline-edit-target": "form" } do |form| %>
          <%= form.text_field :title,
              class: "inline-edit-input text-center",
              data: {
                "inline-edit-target": "input",
                action: "blur->inline-edit#save keydown.enter->inline-edit#save keydown.escape->inline-edit#cancel"
              }
          %>
        <% end %>
      </div>
    <% end %>

    <%# Actions - visible on hover %>
    <div class="absolute top-4 right-3 flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
      <%= button_to list_path(list), method: :delete, data: { turbo_confirm: 'Delete this list and all its tasks?' }, class: "btn-icon" do %>
        <%= heroicon('trash', variant: :mini, options: { class: 'h-4 w-4' }) %>
      <% end %>
    </div>
  </header>

  <%# Todo list %>
  <ul
    id="todos_<%= list.id %>"
    data-controller="sortable"
    data-sortable-group-value="todos"
    data-sortable-list-id="<%= list.id %>"
    class="flex-1 space-y-1 min-h-[60px]"
  >
    <% list.todos.rank(:row_order).each do |todo| %>
      <li data-sortable-id="<%= todo.id %>" data-sortable-update-url="<%= sort_todo_path(todo) %>">
        <%= render todo %>
      </li>
    <% end %>
  </ul>

  <%# Add todo form %>
  <footer class="mt-3 pt-3 border-t border-cork-300/30">
    <%= form_with url: todos_path, class: "flex gap-2", data: { controller: "add-todo", turbo_frame: "_top" } do |form| %>
      <%= form.hidden_field :todo, value: "", name: "todo[list_id]" %>
      <%= form.hidden_field :todo, value: list.id, name: "todo[list_id]" %>
      <input
        type="text"
        name="todo[title]"
        placeholder="Add a task..."
        class="flex-1 bg-transparent border-0 border-b border-cork-300/50 focus:border-cork-500 focus:ring-0 font-handwriting text-cork-700 placeholder:text-cork-400 px-0 py-1 text-sm"
        data-add-todo-target="input"
        data-action="keydown.enter->add-todo#submit"
      />
      <button type="submit" class="btn-icon text-cork-500 hover:text-cork-700">
        <%= heroicon('plus', variant: :mini, options: { class: 'h-4 w-4' }) %>
      </button>
    <% end %>
  </footer>
</div>
