<div
  id="<%= dom_id list %>"
  class="
    group relative
    bg-yellow-100 hover:bg-yellow-50
    rounded-lg shadow-lg hover:shadow-xl
    transition-all duration-200 ease-out
    hover:-translate-y-1
    p-4 min-h-[180px]
    border border-yellow-200
  "
  data-controller="list"
  data-list-id="<%= list.id %>"
>
  <%# Pin decoration %>
  <div class="absolute -top-2 left-1/2 -translate-x-1/2 z-10">
    <div class="w-4 h-4 rounded-full bg-red-500 shadow-md border-2 border-red-600"></div>
  </div>

  <%# Header with title and actions %>
  <header class="flex items-start justify-between gap-2 pt-2 mb-3">
    <h3 class="text-lg font-semibold text-slate-800 truncate flex-1 text-center px-6">
      <%= list.title %>
    </h3>

    <%# Actions - visible on hover %>
    <div class="absolute top-3 right-3 flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
      <%= button_to edit_list_path(list), method: :get, data: { turbo_frame: 'modal' }, class: "p-1.5 rounded-full hover:bg-yellow-200 text-slate-500 hover:text-sky-600 transition-colors" do %>
        <%= heroicon('pencil', variant: :mini, options: { class: 'h-4 w-4' }) %>
      <% end %>

      <%= button_to list_path(list), method: :delete, data: { turbo_confirm: 'Delete this list and all its tasks?' }, class: "p-1.5 rounded-full hover:bg-yellow-200 text-slate-500 hover:text-red-600 transition-colors" do %>
        <%= heroicon('trash', variant: :mini, options: { class: 'h-4 w-4' }) %>
      <% end %>
    </div>
  </header>

  <%# Todo list %>
  <ul
    id="todos_<%= list.id %>"
    data-controller="sortable"
    data-sortable-group-value="todos"
    data-sortable-list-id="<%= list.id %>"
    class="space-y-2 min-h-[60px]"
  >
    <% list.todos.rank(:row_order).each do |todo| %>
      <li data-sortable-id="<%= todo.id %>" data-sortable-update-url="<%= sort_todo_path(todo) %>">
        <%= render todo %>
      </li>
    <% end %>
  </ul>

  <%# Add todo button %>
  <footer class="mt-4 pt-3 border-t border-yellow-200/50">
    <%= button_to todos_path, params: { todo: { title: 'New todo', list_id: list.id } }, class: "w-full flex items-center justify-center gap-2 py-2 text-sm text-slate-500 hover:text-slate-700 hover:bg-yellow-200/50 rounded-lg transition-colors" do %>
      <%= heroicon('plus', variant: :mini, options: { class: 'h-4 w-4' }) %>
      <span>Add task</span>
    <% end %>
  </footer>
</div>
