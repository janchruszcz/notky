<%= turbo_frame_tag "modal" do %>
  <div class="modal-backdrop" data-controller="turbo-modal" data-action="keyup@window->turbo-modal#closeWithKeyboard click->turbo-modal#closeBackground">
    <div class="modal-content sticky-note note-yellow" data-turbo-modal-target="modal" data-action="click->turbo-modal#stopPropagation">
      <%# Push pin %>
      <div class="push-pin"></div>

      <%# Header %>
      <div class="pt-6 pb-4 px-6 border-b border-cork-200/50">
        <h2 class="note-title text-center text-2xl">Create New List</h2>
      </div>

      <%# Form %>
      <div class="p-6">
        <%= form_with model: @list, class: "space-y-4" do |form| %>
          <% if @list.errors.any? %>
            <div class="bg-red-50 text-red-700 px-4 py-3 rounded-lg text-sm">
              <ul class="list-disc list-inside space-y-1">
                <% @list.errors.full_messages.each do |error| %>
                  <li><%= error %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div>
            <label for="list_title" class="block text-sm font-medium text-cork-700 mb-2">List Title</label>
            <%= form.text_field :title,
                class: "w-full bg-white/80 border-2 border-cork-300 focus:border-cork-500 focus:ring-0 rounded-lg px-4 py-3 font-handwriting text-xl text-cork-800 placeholder:text-cork-400",
                placeholder: "e.g., Shopping List, Work Tasks...",
                autofocus: true,
                required: true
            %>
          </div>

          <%= form.hidden_field :user_id, value: current_user.id %>

          <div class="flex items-center justify-end gap-3 pt-2">
            <button type="button" data-action="turbo-modal#hideModal" class="btn-secondary">
              Cancel
            </button>
            <%= form.submit "Create List", class: "btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
