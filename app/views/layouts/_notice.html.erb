<div data-controller="alert"
  data-transition-enter="transform ease-out duration-300 transition"
  data-transition-enter-start="translate-y-2 opacity-0 sm:translate-y-0 sm:translate-x-2"
  data-transition-enter-end="translate-y-0 opacity-100 sm:translate-x-0"
  data-transition-leave="transition ease-in duration-100"
  data-transition-leave-start="opacity-100"
  data-transition-leave-end="opacity-0"
  class="max-w-sm w-full bg-note-green shadow-note rounded-lg pointer-events-auto overflow-hidden hidden">
  <div class="p-4">
    <div class="flex items-start">
      <div class="flex-shrink-0">
        <%= heroicon('check-circle', variant: :solid, options: { class: 'h-6 w-6 text-green-600' }) %>
      </div>
      <div class="ml-3 w-0 flex-1 pt-0.5">
        <p class="text-sm font-medium text-cork-900">Success!</p>
        <p class="mt-1 text-sm text-cork-700"><%= notice %></p>
        <% flash[:notice] = nil %>
      </div>
      <div class="ml-4 flex-shrink-0 flex">
        <button type="button" data-action="alert#close" class="bg-transparent rounded-full inline-flex text-cork-500 hover:text-cork-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-cork-400 p-1">
          <span class="sr-only">Close</span>
          <%= heroicon('x-mark', variant: :mini, options: { class: 'h-5 w-5' }) %>
        </button>
      </div>
    </div>
  </div>
</div>
